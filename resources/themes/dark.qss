/* LUMAFLOW dark theme - restrained electric blue (#3d8bff) and violet (#9a5cff) accents */
* { font-size: 10pt; }
QWidget { background-color: #15161d; color: #d9dbe8; selection-background-color: #3d6fd9; selection-color: #ffffff; }
QMainWindow::separator { background: #23243a; width: 4px; height: 4px; }
QDockWidget { titlebar-close-icon: none; color: #c9cdf0; }
QDockWidget::title { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #1f2238, stop:1 #191a28); padding: 5px 8px; border-bottom: 1px solid #2f3352; font-weight: bold; }
QTabWidget::pane { border: 1px solid #2a2c44; top: -1px; }
QTabBar::tab { background: #1b1c28; color: #9ea3c6; padding: 6px 12px; border: 1px solid #2a2c44; border-bottom: none; margin-right: 1px; }
QTabBar::tab:selected { background: #24263a; color: #ffffff; border-top: 2px solid #3d8bff; }
QPushButton { background: #23253a; border: 1px solid #343858; border-radius: 4px; padding: 5px 12px; min-height: 18px; }
QPushButton:hover { background: #2c2f4a; border-color: #4b6bd6; }
QPushButton:pressed { background: #3d6fd9; }
QPushButton:checked { background: #3b2f6e; border-color: #9a5cff; }
QPushButton#go { background: #1e4fb8; font-weight: bold; font-size: 12pt; }
QPushButton#take { background: #4a2c95; font-weight: bold; }
QPushButton#blackout { background: #5a1d28; font-weight: bold; }
QPushButton#blackout:checked { background: #c0263f; color: white; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit { background: #0f1017; border: 1px solid #2f3352; border-radius: 3px; padding: 3px; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #1b1c28; border: 1px solid #343858; }
QSlider::groove:horizontal { height: 6px; background: #262840; border-radius: 3px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2f6fe8, stop:1 #8a52f5); border-radius: 3px; }
QSlider::handle:horizontal { background: #e8eaff; width: 14px; margin: -5px 0; border-radius: 7px; }
QSlider::groove:vertical { width: 8px; background: #262840; border-radius: 4px; }
QSlider::add-page:vertical { background: qlineargradient(x1:0,y1:1,x2:0,y2:0, stop:0 #2f6fe8, stop:1 #8a52f5); border-radius: 4px; }
QSlider::handle:vertical { background: #e8eaff; height: 18px; margin: 0 -6px; border-radius: 6px; }
QHeaderView::section { background: #1f2133; color: #aab0d6; padding: 4px; border: none; border-right: 1px solid #2a2c44; }
QTableView, QTreeView, QListView { background: #111219; alternate-background-color: #161722; gridline-color: #24263a; border: 1px solid #262840; }
QTableView::item:selected, QListView::item:selected, QTreeView::item:selected { background: #2d4fa8; }
QGroupBox { border: 1px solid #2a2c44; border-radius: 5px; margin-top: 12px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #8fb4ff; }
QScrollBar:vertical { background: #13141b; width: 10px; } QScrollBar::handle:vertical { background: #34385a; border-radius: 4px; min-height: 24px; }
QScrollBar:horizontal { background: #13141b; height: 10px; } QScrollBar::handle:horizontal { background: #34385a; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QMenuBar { background: #12131a; } QMenuBar::item:selected { background: #2b2e48; }
QMenu { background: #1a1b27; border: 1px solid #343858; } QMenu::item:selected { background: #2d4fa8; }
QToolBar { background: #12131a; border-bottom: 1px solid #262840; spacing: 6px; padding: 3px; }
QStatusBar { background: #101119; color: #9aa0c8; }
QToolTip { background: #24263a; color: #ffffff; border: 1px solid #4b6bd6; }
QCheckBox::indicator { width: 16px; height: 16px; }
QLabel#warning { color: #ffb347; }
QLabel#title { color: #8fb4ff; font-weight: bold; font-size: 11pt; }
